# --- Variables SERVEUR (Cloudflare : wrangler secret put NOM ; Vercel : Environment Variables) ---
# Supabase PostgreSQL backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-server-only-service-role-key

# Session signing (minimum 32 random characters)
SESSION_SECRET=replace-with-a-long-random-secret

# Initial administrator account
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-long-password

# Public application URL
SITE_URL=http://localhost:3000

# Optional FedaPay integration
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# Optional SMS integration
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Classio
