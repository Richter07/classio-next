# Copier en infra/.env.prod (jamais dans git), puis remplir.
# Secrets : `openssl rand -hex 32` pour chacun. Hexadécimal : sans caractère à échapper dans une URL.
DOMAIN=app.classio.bj
# Domaine parent : les sous-domaines d'école seront <ecole>.BASE_DOMAIN quand on les activera.
BASE_DOMAIN=classio.bj
ACME_EMAIL=contact@classio.bj

DJANGO_SECRET_KEY=
ACCESS_CODE_KEY=
POSTGRES_PASSWORD=
CLASSIO_OWNER_PASSWORD=
CLASSIO_APP_PASSWORD=

SENTRY_DSN=
