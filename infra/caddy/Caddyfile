{
	email {$ACME_EMAIL}
	servers {
		# Adresse réelle du visiteur, lue dans l'en-tête du tunnel Cloudflare seulement quand la
		# requête vient d'un relais de confiance. En production, aucun : l'adresse vue par Caddy
		# fait foi (un en-tête envoyé par un visiteur est ignoré).
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		# Render : « Cf-Connecting-IP X-Forwarded-For » ; X-Forwarded-For est alors lu de droite à
		# gauche, en sautant les relais de confiance (la partie gauche peut être inventée).
		client_ip_headers {$CLIENT_IP_HEADERS:Cf-Connecting-IP}
		trusted_proxies_strict
	}
}

# Production : le domaine (HTTPS automatique). Serveur de test derrière un tunnel : « :80 », le
# tunnel assure le HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Fichiers statiques de l'administration Django.
	handle_path /static/* {
		root * {$DJANGO_STATIC_ROOT:/srv/django-static}
		file_server
	}

	@backend path /api/* /admin /admin/*
	handle @backend {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000} {
			# Une seule adresse fait foi (cf. TRUSTED_PROXY_COUNT=1) : celle vue par Caddy, ou
			# celle donnée par un relais de confiance (voir trusted_proxies).
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		# Politique de sécurité du contenu pour l'application : aucun script externe ou en ligne.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Tout le reste (index.html servi pour /, /parent, /ecole…, sw.js, manifeste, icônes) est
		# revalidé à chaque fois : sinon un navigateur garde une ancienne page qui réclame des
		# fichiers /assets/ supprimés au déploiement suivant.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
