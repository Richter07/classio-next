DJANGO_SECRET_KEY=dev-uniquement-a-remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=True
# Domaine de base : <ecole>.BASE_DOMAIN. Voir la décision à prendre dans docs/02-architecture.md.
BASE_DOMAIN=classio.localhost
ALLOWED_HOSTS=.classio.localhost,localhost,127.0.0.1

# Exécution de l'application : rôle sans BYPASSRLS.
DATABASE_URL=postgres://classio_app:app_dev@127.0.0.1:5432/classio
# Migrations et tests uniquement : rôle propriétaire.
MIGRATION_DATABASE_URL=postgres://classio_owner:owner_dev@127.0.0.1:5432/classio

REDIS_URL=redis://127.0.0.1:6379/0
# Clé HMAC des codes OTP, distincte de DJANGO_SECRET_KEY.
OTP_HMAC_KEY=dev-uniquement-a-remplacer
SENTRY_DSN=
